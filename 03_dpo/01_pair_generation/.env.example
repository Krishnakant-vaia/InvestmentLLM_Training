# Paste your credentials after each "=" (no quotes, no spaces) into a copy of this file named .env.
# The .env file is read by every script in this folder and is copied to the Daytona sandbox WITHOUT the DAYTONA_* lines.

# ---- AWS: read the documents, write the QA pairs ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (SSO/STS) credentials:
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-south-1

# ---- Daytona: GPU sandbox that hosts gpt-oss-120b -----------------------------------------------------
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=

# ---- Hugging Face (optional): avoids download rate limits for openai/gpt-oss-120b (~65 GB, public) ----------
HF_TOKEN=

# ---- Optional overrides (leave blank for the defaults in config.py) ---------------------------------------
# Where the QA pairs are saved (default: s3://ft-vaia/Corpus/Invest_dataset/100626_Dataset_DPO/qa_pairs/)
DPO_S3_OUT_PREFIX=
# Extra `vllm serve` flags, e.g. --reasoning-parser openai_gptoss if the smoke test shows the answer left in the reasoning field
VLLM_SERVE_ARGS=
# Generation workers against the local server, and reasoning effort (low | medium | high)
DPO_WORKERS=
DPO_REASONING_EFFORT=
