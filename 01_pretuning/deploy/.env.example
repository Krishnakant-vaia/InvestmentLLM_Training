# Copy this file to deploy/.env and fill in real values, then transfer it to
# the pod via scp (not by typing/pasting into the SSH terminal — that's what
# caused the credential corruption during the last pod's setup).
#
# deploy/.env is never committed or printed — it holds live credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
WANDB_API_KEY=
