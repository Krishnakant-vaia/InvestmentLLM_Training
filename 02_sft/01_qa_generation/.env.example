# Copy this file to .env (same directory) and fill in real values yourself.
# sft_config.py loads .env from this same folder.

# --- Cloudflare Workers AI (required) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- AWS (only needed if boto3 can't already find credentials via ~/.aws/credentials
# or the standard AWS_* environment variables on this machine) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# --- optional overrides (see sft_config.py for defaults) ---
# SFT_MAX_WORKERS=24
# SFT_REASONING_EFFORT=medium
# SFT_CHUNK_CHARS=6000
# SFT_CHUNK_OVERLAP_CHARS=400
# SFT_S3_BUCKET=ft-vaia
# SFT_S3_PREFIX=Corpus/Invest_dataset/082126_fliteredextractionrun2/
# SFT_S3_FETCH_WORKERS=64
# SFT_S3_OUTPUT_PREFIX=s3://ft-vaia/Corpus/Invest_dataset/09032026_SFTQ&Apairs/
# SFT_S3_UPLOAD_INTERVAL_CHUNKS=2000
# SFT_OUTPUT_PATH=
# SFT_LOG_PATH=
